{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "types": [],
    "noEmit": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/src"
  },
  "include": ["src/browser/**/*.ts", "src/core/**/*.ts", "src/data/**/*.ts", "src/i18n/**/*.ts"]
}
