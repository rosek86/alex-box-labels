{
  "name": "box-labels",
  "version": "1.0.0",
  "private": true,
  "description": "Lokalny edytor etykiet samoprzylepnych A4",
  "scripts": {
    "start": "node server.ts",
    "dev": "node --watch server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "build": "node scripts/build.ts"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
